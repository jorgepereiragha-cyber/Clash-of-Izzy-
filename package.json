{
  "name": "clash-of-izzy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler --config wrangler.jsonc deploy",
    "dev": "wrangler --config wrangler.jsonc dev",
    "db:migrate:local": "wrangler --config wrangler.jsonc d1 migrations apply clash-of-izzy-db --local",
    "db:migrate:remote": "wrangler --config wrangler.jsonc d1 migrations apply clash-of-izzy-db --remote",
    "check": "wrangler --config wrangler.jsonc deploy --dry-run --outdir=dist",
    "test": "node --test",
    "assets:validate": "node scripts/validate-3d-assets.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "wrangler": "4.161.0",
    "@playwright/test": "1.65.1"
  }
}
