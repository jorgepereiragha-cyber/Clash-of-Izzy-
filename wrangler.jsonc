{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clash-of-izzy",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-11-12",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_REALTIME", "class_name": "GameRealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1-realtime-hub", "new_sqlite_classes": ["GameRealtimeHub"] }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clash-of-izzy-db",
      "database_id": "7e63af59-d9ff-4159-a9cf-b02e35b92605",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "previews": {}
}
