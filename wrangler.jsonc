{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "clash-of-izzy",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clash-of-izzy-db",
      "database_id": "7e63af59-d9ff-4159-a9cf-b02e35b92605"
    }
  ]
}
