{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clash-of-izzy",
  "main": "worker.js",
  "build": {
    "command": "npm run vendor:three"
  },
  "workers_dev": true,
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clash-of-izzy-db",
      "database_id": "7e63af59-d9ff-4159-a9cf-b02e35b92605",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "izzy-preview-17112026",
        "database_id": "6674c0ac-3636-4e57-bff8-23cf60ab9637"
      }
    ]
  }
}
