<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: the same royal-king foreground as the launcher and in-app loading overlay. -->
<resources>
    <style name="Theme.ClashOfIzzy" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#081831</item>
        <item name="android:navigationBarColor">#081831</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#081831</item>
        <item name="android:windowSplashScreenBackground">@color/coi_icon_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/coi_icon_background</item>
    </style>
</resources>
