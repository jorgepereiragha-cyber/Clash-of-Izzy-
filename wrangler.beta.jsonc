{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clash-of-izzy-beta",
  "main": "worker.js",
  "build": {
    "command": "npm run vendor:three"
  },
  "workers_dev": true,
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "clash-of-izzy-beta-db",
    "database_id": "REPLACE_WITH_NEW_BETA_D1_UUID",
    "migrations_dir": "migrations"
  }],
  "durable_objects": {
    "bindings": [{
      "name": "ELDORIA_ROOM",
      "class_name": "EldoriaRoom"
    }]
  },
  "migrations": [{
    "tag": "v1-eldoria-room",
    "new_sqlite_classes": ["EldoriaRoom"]
  }],
  "vars": {
    "ENVIRONMENT": "beta",
    "INVITE_ONLY": "true",
    "BETA_LIVE_PAYMENTS_APPROVED": "false",
    "GAME_4X_SYSTEMS_ENABLED": "false",
    "LEVEL_PACKS_ENABLED": "false",
    "LEVEL_PACKS_PUBLIC_ENABLED": "false",
    "LEVEL_PACKS_PROPOSED_PRICES_APPROVED": "false",
    "MASTER_PACK_ENABLED": "false"
  }
}
